{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title | htmlEscape }}</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>{{ site.Params.description | htmlEscape }}</description>
    <language>{{ site.Language.Locale }}</language>
    {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>{{ end }}
    {{ range (where (where site.RegularPages "Section" "in" (slice "writing" "work")) "Draft" false).ByDate.Reverse }}
      <item>
        <title>{{ .Title | htmlEscape }}</title>
        <link>{{ .Permalink }}</link>
        <guid>{{ .Permalink }}</guid>
        <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
        <description>{{ .Description | htmlEscape }}</description>
      </item>
    {{ end }}
  </channel>
</rss>
